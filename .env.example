# Fully usable local demo; keys stay server-side.
DEMO_MODE=true
DATA_DIR=.data/pile
# Optional hosted PostgreSQL. Tiger takes precedence over DATABASE_URL.
TIGER_DATABASE_URL=
DATABASE_URL=
# Optional text and image understanding. Without it, local text/syllabus rules and sample flyer work.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Real recording -> transcript; independent of the text/vision provider.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
# Google OAuth; set all four to connect a real calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/oauth/callback
TOKEN_ENCRYPTION_KEY=
# Explicit persistent memory; Pile creates a private assistant per browser account.
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api

# Set to 4 on Vercel to stay below its multipart request limit; local default is 8 MB.
NEXT_PUBLIC_MAX_UPLOAD_MB=8
