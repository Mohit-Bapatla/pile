# Works without external credentials. Keep the server on localhost for a personal demo.
DEMO_MODE=true
# Optional standard PostgreSQL / Tiger Data connection; otherwise disk-backed PGlite.
DATABASE_URL=
DATA_DIR=.data/pile
# Real text/vision/transcription provider. Keys stay on the server.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional Google Calendar OAuth. Requires an encryption key (32+ characters).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/oauth/callback
TOKEN_ENCRYPTION_KEY=
# Optional persistent Backboard memory (pre-created assistant + thread).
BACKBOARD_API_KEY=
BACKBOARD_THREAD_ID=
BACKBOARD_BASE_URL=https://app.backboard.io/api
