{
  "name": "pile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "fixtures": "tsx scripts/fixtures.ts",
    "format": "prettier --write .",
    "secret:scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@radix-ui/react-dialog": "latest",
    "chrono-node": "latest",
    "date-fns": "latest",
    "date-fns-tz": "latest",
    "dotenv": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "pdf-parse": "^2.4.5",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "pdf-lib": "latest",
    "prettier": "^3.9.6",
    "sharp": "latest",
    "tsx": "latest",
    "typescript": "~5.9.3",
    "vitest": "latest"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  }
}
